<html>
  <head><title>Write a new Message</title></head>

  <form method="post" action="/new">
    <label for="user">Name</label>
    <input id="user" name="user" placeholder="Enter your name"/>

    <label for="message">Message</label>
    <input id="message"  name="message" placeholder="Write your message"/>

    <button>Submit</button>
  </form>
</html>
